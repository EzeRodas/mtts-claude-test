<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MoonTTS.Avalonia.App"
             xmlns:local="using:MoonTTS.Avalonia"
             xmlns:vm="using:MoonTTS.Avalonia.ViewModels"
             x:DataType="vm:MainViewModel"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
             <TrayIcon.Icons>
                 <TrayIcons>
                     <TrayIcon Icon="/Assets/icon.ico"
                               ToolTipText="Moon-TTS"
                               Command="{Binding ShowMainWindowCommand}">
                         <TrayIcon.Menu>
                             <NativeMenu>
                                 <NativeMenuItem Header="Open Moon-TTS" Command="{Binding ShowMainWindowCommand}"/>
                                 <!-- Place Settings item here -->
                                 <NativeMenuItem Header="Settings" Command="{Binding ToggleSettingsCommand}"/>
                                 <NativeMenuItemSeparator/>
                                 <NativeMenuItem Header="Exit" Command="{Binding ExitAppCommand}"/>
                             </NativeMenu>
                         </TrayIcon.Menu>
                     </TrayIcon>
                 </TrayIcons>
             </TrayIcon.Icons>
</Application>