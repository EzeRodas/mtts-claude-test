<Project Sdk="Microsoft.NET.Sdk">

  <!-- Public contract shared by the host and every engine worker written in C#.
       Workers in other languages implement the same framing described in IPC-engine-model.md -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
