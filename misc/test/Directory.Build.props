<Project>
  <!-- Shared settings for every test project under misc/test -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Test doubles never ship, so they are not held to the app's AOT rules -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)MoonTTS.Tests.Common/MoonTTS.Tests.Common.csproj" />
    <Using Include="Xunit" />
    <Using Include="MoonTTS.Tests.Common" />
  </ItemGroup>
</Project>
